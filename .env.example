# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: SERVER ONLY. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI Provider Configuration (Google Gemini / OpenAI)
# ---------------------------------------------------------------------------
# AI_PROVIDER can be 'gemini', 'openai', or 'auto' (defaults to 'auto' which
# uses Gemini when GEMINI_API_KEY is present, else OpenAI).
AI_PROVIDER=gemini

# Google Gemini (Primary provider)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# OpenAI (Supported as secondary / fallback)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Upstash Redis rate limiting (OPTIONAL - an in-memory limiter is used when absent)
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_STORAGE_BUCKET=resumes
